	tshaders_nolight:"models/truck3/main2nl.shd:models/truck3/main2nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main1nl.shd:models/truck3/main0nl.shd"
	tinside:"models/interior3/interior.psm"
	tinside_shd:"models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main2.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main0.shd:models/interior3/main1.shd:models/interior3/rpm.shd:models/interior3/mph.shd:models/interior3/main0.shd:models/interior3/main0.shd"
	cabin_sc:0.5
	#kg
	#tweight:3000
	tweight:2300
	#m
	theight:3
	
	#wheel defintions
	wfmodel:"models/wheel_f/wheel_f.psm"
	wfshaders:"models/wheel_f/wheel_f.shd"
	wfshaders_nolight:"models/wheel_f/wheel_fnl.shd"
