	wrshaders:"models/wheel_r/wheel_r.shd"
	wrshaders_nolight:"models/wheel_r/wheel_rnl.shd"
	wrcount:4
	wbcam_off:10

	#car behavior
	#degs/s
	steer_speed:40
	#degs
	steer_max:45

	tmax_speed:97

	gear_count:8
	gearR:6.42
	gear1:6.42
	gear2:3.67
	gear3:2.9
	gear4:2.0
	gear5:1.65
	gear6:1.35is_out = (drop_field[ii].pos[1] > y_size) || (drop_field[ii].pos[1] < y_offs);
	gear7:1.2
	gear8:1.15


	torque_coef:0.8
	thorse_power:375
	horn_snd:"sounds/truck/ti_horn01.ogg"
	tname:"T1000"
	wiper_max:-110.0
	gr_x_size_l:-17
	gr_y_size_l:15.5
	gr_x_coef_l:0.4
	gr_y_coef_l:0.05
	gr_x_size_r:17
	gr_y_size_r:15.5
	gr_x_coef_r:0.4
	gr_y_coef_r:0.05
