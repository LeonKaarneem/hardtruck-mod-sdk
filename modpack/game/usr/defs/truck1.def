	tshaders:"models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main2.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main1.shd:models/truck1/main0.shd"
	tshaders_nolight:"models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main2nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main1nl.shd:models/truck1/main0nl.shd"
	tinside:"models/interior1/interior.psm"
	tinside_shd:"models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main0.shd:models/interior1/main1.shd:models/interior1/main0.shd:models/interior1/main2.shd:models/interior1/main0.shd:models/interior1/rpm.shd:models/interior1/mph.shd:models/interior1/main0.shd:models/interior1/main0.shd"
	cabin_sc:0.4
	#kg
	tweight:2000
	#m
	theight:3
	
	#wheel defintions
	wfmodel:"models/wheel_f/wheel_f.psm"
	wfshaders:"models/wheel_f/wheel_f.shd"
